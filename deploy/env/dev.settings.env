# Non-secret server settings, appended to the decrypted secrets by deploy.sh.
# dev (srv-dev): the branch under review, deployed by hand with deploy.sh dev.
# Secrets (keys, passwords, URLs with credentials) belong in the .env.age file;
# until deploy/env/dev.env.age exists, dev uses staging's.

# srv-dev's own address (staging's secrets carry staging's): the browser's
# origin must match it exactly, or writes fail as cross-site requests.
AXON_BASE_URL=https://srv-dev.tail781d53.ts.net
WEBAUTHN_RP_ID=srv-dev.tail781d53.ts.net

# The shared demo account: sample data, reset nightly, no passkey (EP-28, ADR 0015).
AXON_DEMO=1

# Suggested address of the anki-sync-server for the Anki bridge (EP-42).
ANKI_SYNC_URL=http://srv-services:8080/
