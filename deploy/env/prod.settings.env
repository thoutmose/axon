# Non-secret server settings, appended to the decrypted secrets by deploy.sh.
# Secrets (keys, passwords, URLs with credentials) belong in the .env.age file.

# The shared demo account: sample data, reset nightly, no passkey (EP-28, ADR 0015).
AXON_DEMO=1

# Suggested address of the anki-sync-server for the Anki bridge (EP-42).
ANKI_SYNC_URL=http://srv-services:8080/

# Nginx Proxy Manager on srv-npm, which serves https://axon.thoutmose.me in
# front of Tailscale Serve: its tailnet address is a proxy, not the client (EP-168).
AXON_TRUSTED_PROXIES=100.95.163.114/32

# FreshRSS and Audiobookshelf on srv-services, over the tailnet: followed feeds,
# calendars, and servers may be on a private network (EP-58, EP-110, EP-124).
AXON_CALENDAR_PRIVATE=1
COMPOSE_PROFILES=tunnel

# The Cloudflare Tunnel that makes https://axon.thoutmose.me public (owner
# request); its token, a secret, is CLOUDFLARE_TUNNEL_TOKEN in prod.env.age.
COMPOSE_PROFILES=tunnel
