{
	"name": "axon-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest run",
		"gen:api": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/api-types.ts && prettier --write src/lib/api-types.ts",
		"predev": "node scripts/api-docs.js",
		"prebuild": "node scripts/api-docs.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.64.1",
		"@simplewebauthn/browser": "^13.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"swagger-ui-dist": "5.33.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@axe-core/playwright": {
			"playwright-core": "1.63.0"
		}
	}
}
