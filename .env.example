# Copy to .env for local development. Never commit .env.
# Variables marked "unused yet" are reserved by the README and wired in later Epics.

AXON_BASE_URL=http://localhost:3000
AXON_ENV=development

POSTGRES_USER=axon
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=axon
DATABASE_URL=postgres://axon:local-dev-only@db:5432/axon?sslmode=disable
REDIS_URL=redis://valkey:6379/0

# Generate with: openssl rand -hex 32 (unused yet, EP-04)
SESSION_SECRET=
# Passkey relying-party ID (unused yet, EP-04)
WEBAUTHN_RP_ID=localhost

# Optional integrations (unused yet)
ANTHROPIC_API_KEY=
TMDB_API_KEY=
ANKI_SYNC_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
S3_BACKUP_BUCKET=
